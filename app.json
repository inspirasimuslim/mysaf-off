{
  "expo": {
    "name": "MySAFF",
    "slug": "mysaf-off",
    "version": "1.2.1",
    "orientation": "portrait",
    "icon": "./assets/images/mysaff-icon-white.png",
    "scheme": "mysafoff",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAFAFA",
    "ios": {
      "bundleIdentifier": "com.sakuradigital.mysafoff",
      "supportsTablet": true
    },
    "android": {
      "package": "com.sakuradigital.mysafoff",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/mysaff-adaptive-foreground-v3.png",
        "monochromeImage": "./assets/images/mysaff-adaptive-monochrome-v3.png"
      },
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCL-FL_X1opxAHRG8mhXZE2E90Ftk-QPHk"
        }
      }
    },
    "web": {
      "output": "static",
      "bundler": "metro",
      "favicon": "./assets/images/mysaff-icon-transparent.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAFAFA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Benarkan $(PRODUCT_NAME) menggunakan Face ID untuk membuka kunci akaun anda."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Benarkan $(PRODUCT_NAME) menggunakan Face ID untuk log masuk."
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "MySAFF menggunakan lokasi anda untuk mengesahkan kehadiran usrah di lokasi program."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "MySAFF menggunakan kamera untuk mengimbas kod QR kehadiran usrah.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MySAFF perlu capaian galeri untuk membaca kod QR daripada gambar yang anda pilih."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "MySAFF perlu capaian galeri untuk membaca kod QR daripada gambar yang anda pilih.",
          "savePhotosPermission": "MySAFF perlu kebenaran untuk menyimpan kod QR dan gambar ke galeri anda.",
          "granularPermissions": ["photo"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
