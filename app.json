{
  "expo": {
    "name": "MySAFF",
    "slug": "mysaf-off",
    "version": "1.3.24",
    "orientation": "portrait",
    "icon": "./assets/images/mysaff-icon-white.png",
    "scheme": "mysafoff",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FAFAFA",
    "ios": {
      "bundleIdentifier": "com.sakuradigital.mysafoff",
      "supportsTablet": true
    },
    "android": {
      "package": "com.sakuradigital.mysafoff",
      "versionCode": 30,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/mysaff-adaptive-foreground-v3.png",
        "monochromeImage": "./assets/images/mysaff-adaptive-monochrome-v3.png"
      },
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCL-FL_X1opxAHRG8mhXZE2E90Ftk-QPHk"
        }
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ]
    },
    "web": {
      "output": "static",
      "bundler": "metro",
      "favicon": "./assets/images/mysaff-icon-transparent.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAFAFA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Benarkan $(PRODUCT_NAME) menggunakan Face ID untuk membuka kunci akaun anda."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Benarkan $(PRODUCT_NAME) menggunakan Face ID untuk log masuk."
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "MySAFF menggunakan lokasi anda untuk mengesahkan kehadiran usrah di lokasi program."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "MySAFF menggunakan kamera untuk mengimbas kod QR kehadiran usrah.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MySAFF perlu capaian galeri untuk membaca kod QR daripada gambar yang anda pilih."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "MySAFF perlu capaian galeri untuk membaca kod QR daripada gambar yang anda pilih.",
          "savePhotosPermission": "MySAFF perlu kebenaran untuk menyimpan kod QR dan gambar ke galeri anda.",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "reactNativeArchitectures": ["arm64-v8a"],
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5212c1fc-3e32-4621-b563-9c5a507bbb21"
      }
    },
    "owner": "inspirasimuslim"
  }
}
