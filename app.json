{
  "expo": {
    "name": "mysaf-off",
    "slug": "mysaf-off",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mysafoff",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAFAFA",
    "ios": {
      "bundleIdentifier": "com.sakuradigital.mysafoff",
      "supportsTablet": true,
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.sakuradigital.mysafoff",
      "adaptiveIcon": {
        "backgroundColor": "#E7F1EC",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAFAFA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Benarkan $(PRODUCT_NAME) menggunakan Face ID untuk membuka kunci akaun anda."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Benarkan $(PRODUCT_NAME) menggunakan Face ID untuk log masuk."
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "mysaf-off menggunakan lokasi anda untuk mengesahkan kehadiran usrah di lokasi program."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "mysaf-off menggunakan kamera untuk mengimbas kod QR kehadiran usrah.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "mysaf-off perlu capaian galeri untuk membaca kod QR daripada gambar yang anda pilih."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
