# Supabase — Free plan
# Dapatkan nilai ini di: Supabase Dashboard > Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Maps (kunci WEB: Maps JavaScript API + Places API (New)).
# Kunci Android Maps SDK berasingan — di app.json > android.config.googleMaps.apiKey
EXPO_PUBLIC_GOOGLE_MAPS_WEB_API_KEY=
